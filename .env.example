# ─────────────────────────────────────────────────────────────────────────────
# UniVo environment settings.
#   1. Copy this file to ".env" in the project root:   cp .env.example .env
#      (Windows: copy .env.example .env)
#   2. Fill in the values below.
#   3. NEVER commit ".env" (it is listed in .gitignore) and never paste real
#      secrets into this example file.
# ─────────────────────────────────────────────────────────────────────────────

# Local development: True.  Production (Render, VPS...): False (or leave unset).
DEBUG=True

# Required when DEBUG=False. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Use a different key for every environment. Leave empty for local DEBUG=True.
SECRET_KEY=

# Comma-separated hostnames this site is served from (no spaces, no https://).
ALLOWED_HOSTS=localhost,127.0.0.1

# Production only: full origins for HTTPS form posts, e.g. https://your-app.onrender.com
CSRF_TRUSTED_ORIGINS=

# Public base URL used in password-reset emails (optional; falls back to the request URL).
SITE_URL=

# Leave empty to use local SQLite. PostgreSQL format: postgres://user:password@host:5432/dbname
DATABASE_URL=

# Google sign-in (create credentials in Google Cloud Console). Keep these private.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback/

# Razorpay (use TEST keys while developing). Keep these private.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email for password-reset links and 2FA codes.
# Default prints emails to the terminal running the server (fine for local testing).
# For real delivery, switch to SMTP, e.g. Gmail with an "App Password":
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=your-16-char-app-password
#   DEFAULT_FROM_EMAIL=UniVo <you@gmail.com>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Optional: how long a password-reset link stays valid, in seconds (default 1800 = 30 min).
# PASSWORD_RESET_TIMEOUT=1800

# Optional (production): set to False only if your host does not forward HTTPS correctly.
# SECURE_SSL_REDIRECT=True
